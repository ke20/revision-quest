{
  // Type checking of the game's JavaScript (no build: nothing is emitted, the browser runs the same files).
  //   npm run typecheck   (mise run typecheck), also part of npm run qa
  // Types are written as JSDoc comments in the files; shared types live in types/*.d.ts.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2017",
    "lib": ["ES2017", "ES2022.Error", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": []
  },
  "files": ["types/globals.d.ts", "types/pack.d.ts", "types/engine.d.ts", "types/engine-parts.d.ts", "types/scripts.d.ts", "types/exercises-parts.d.ts", "types/editor.d.ts"],
  "include": ["js/core/**/*.js", "js/exercises/**/*.js", "js/app/**/*.js", "js/editor/**/*.js", "js/pages/*.js"]
}
