{
  // Type checking of the Node tools (tools/*.js, tests/server.js): CommonJS, Node types, nothing emitted.
  //   npm run typecheck   (checks this file and tsconfig.json)
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"], // DOM: js/core/pack-rules.js is shared with the browser
    "strict": true,
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["types/*.d.ts", "tools/*.js", "tests/server.js"]
}
