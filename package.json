{
  "name": "revision-quest",
  "version": "1.0.0",
  "private": true,
  "description": "Révision Quest — jeu web de révision par chapitres (HTML/CSS/JS vanilla, sans build).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node tests/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit": "npm audit --audit-level=moderate",
    "validate": "node tools/validate-pack.js --all",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test": "npm run validate && npm run test:unit && npm run test:e2e",
    "qa": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
