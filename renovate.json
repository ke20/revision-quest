{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["before 7am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "ESLint packages move together",
      "matchPackageNames": ["eslint", "@eslint/**"],
      "groupName": "eslint"
    },
    {
      "description": "Playwright: npm package and browsers move together",
      "matchPackageNames": ["@playwright/test", "playwright", "playwright-core"],
      "groupName": "playwright"
    },
    {
      "description": "GitHub Actions: one weekly PR for all of them",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Node.js pinned in mise.toml: stay on the current major (LTS); majors are handled by hand",
      "matchManagers": ["mise"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Patch updates of dev tools merge themselves once CI is green, but only 3 days after their release (time for a hijacked version to be spotted and unpublished)",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    }
  ]
}
